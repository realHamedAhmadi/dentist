{
    "name": "plugin-client",
    "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "implicitDependencies": ["core"],
    "sourceRoot": "resources/js/plugins/client",
    "tags": ["type:plugin", "scope:client"],
    "targets": {
        "build-admin": {
            "executor": "nx:run-commands",
            "options": {
                "command": "vite build --config vite.config.ts",
                "cwd": "resources/js/plugins/client",
                "env": { "BUILD_TARGET": "admin", "PLUGIN_NAME": "client" }
            }
        },
        "build-client": {
            "executor": "nx:run-commands",
            "options": {
                "command": "vite build --config vite.config.ts",
                "cwd": "resources/js/plugins/client",
                "env": { "BUILD_TARGET": "client", "PLUGIN_NAME": "client" }
            }
        },
        "dev-admin": {
            "executor": "nx:run-commands",
            "options": {
                "command": "vite build --config vite.config.ts --watch",
                "cwd": "resources/js/plugins/client",
                "env": { "BUILD_TARGET": "admin", "PLUGIN_NAME": "client" }
            }
        },
        "dev-client": {
            "executor": "nx:run-commands",
            "options": {
                "command": "vite build --config vite.config.ts --watch",
                "cwd": "resources/js/plugins/client",
                "env": { "BUILD_TARGET": "client", "PLUGIN_NAME": "client" }
            }
        }
    }
}
