{
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "name": "client",
    "projectType": "application",
    "implicitDependencies": ["core"],
    "sourceRoot": "resources/js/client",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "options": {
                "command": "BUILD_TARGET=client vite build --config vite.config.ts",
                "cwd": "{workspaceRoot}"
            }
        },
        "dev": {
            "executor": "nx:run-commands",
            "options": {
                "command": "BUILD_TARGET=client vite --config vite.config.ts",
                "cwd": "{workspaceRoot}"
            }
        }
    },
    "tags": ["type:app", "panel:client"]
}
