{
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "name": "admin",
    "projectType": "application",
    "implicitDependencies": ["core"],
    "sourceRoot": "resources/js/admin",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "options": {
                "command": "BUILD_TARGET=admin vite build --config vite.config.ts",
                "cwd": "{workspaceRoot}"
            }
        },
        "dev": {
            "executor": "nx:run-commands",
            "options": {
                "command": "BUILD_TARGET=admin vite --config vite.config.ts",
                "cwd": "{workspaceRoot}"
            }
        }
    },
    "tags": ["type:app", "panel:admin"]
}
