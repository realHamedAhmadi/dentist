{
    "name": "my-dentist",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "create:project-file": "node scripts/gen-nx-projects.mjs",
        "dev-admin": "cross-env BUILD_TARGET=admin vite",
        "dev": "dev-admin",
        "dev-client": "cross-env BUILD_TARGET=client vite",
        "dev:client-admin": "cross-env BUILD_TARGET=admin vite --config resources/js/plugins/client/vite.config.ts",
        "dev:client-client": "cross-env BUILD_TARGET=client vite --config resources/js/plugins/client/vite.config.ts",
        "dev:order-admin": "cross-env BUILD_TARGET=admin vite --config resources/js/plugins/order/vite.config.ts",
        "dev:order-client": "cross-env BUILD_TARGET=client vite --config resources/js/plugins/order/vite.config.ts",
        "build-admin": "cross-env BUILD_TARGET=admin vite build",
        "build": "build-admin",
        "build-client": "cross-env BUILD_TARGET=client vite build --watch",
        "build:client-admin": "cross-env BUILD_TARGET=admin vite build --watch --config resources/js/plugins/client/vite.config.ts",
        "build:client-client": "cross-env BUILD_TARGET=client vite build --watch --config resources/js/plugins/client/vite.config.ts",
        "build:order-admin": "cross-env BUILD_TARGET=admin vite build --watch --config resources/js/plugins/order/vite.config.ts",
        "build:order-client": "cross-env BUILD_TARGET=client vite build --watch --config resources/js/plugins/order/vite.config.ts",
        "dev:all-admin": "concurrently \"npm run dev-admin\" \"npm run build:client-admin\"",
        "dev:all-client": "concurrently \"npm run dev-client\" \"npm run build:client-client\""
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-react": "^4.7.0",
        "concurrently": "^10.0.3",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^6.15.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.1.0",
        "nx": "24.0.6",
        "prettier": "^3.4.2",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "typescript-eslint": "^8.23.0",
        "@nx/eslint": "24.0.6",
        "@nx/vite": "24.0.6"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@headlessui/react": "^2.2.0",
        "@inertiajs/react": "^2.1.0",
        "@mui/icons-material": "^7.3.8",
        "@mui/material": "^7.3.8",
        "@originjs/vite-plugin-federation": "^1.4.1",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.1.2",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@reduxjs/toolkit": "^2.11.2",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.2.13",
        "@types/react-dom": "^19.2.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "globals": "^15.14.0",
        "i18next": "^25.8.6",
        "i18next-browser-languagedetector": "^8.2.1",
        "i18next-http-backend": "^3.0.2",
        "laravel-vite-plugin": "^2.0",
        "lucide-react": "^0.475.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-error-boundary": "^6.1.0",
        "react-i18next": "^16.5.4",
        "react-redux": "^9.2.0",
        "react-router-dom": "^7.13.0",
        "redux-persist": "^6.0.0",
        "semver": "^7.8.0",
        "sirv": "^3.0.2",
        "stylis": "^4.3.6",
        "stylis-plugin-rtl": "^2.1.1",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^5.9.3",
        "vite": "^7.0.4",
        "zustand": "^5.0.13"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "nx": {}
}
